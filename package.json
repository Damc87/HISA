{
  "name": "gradnja-stroski",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "electron": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run electron:build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "5.21.1",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "csv-parse": "5.5.6",
    "csv-stringify": "6.5.0",
    "date-fns": "3.6.0",
    "formidable": "3.5.2",
    "fs-extra": "11.2.0",
    "lucide-react": "0.469.0",
    "next": "14.2.17",
    "pdfkit": "0.15.0",
    "postcss": "8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.6",
    "tailwind-merge": "2.5.2",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.10.5",
    "@types/pdfkit": "0.13.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "9.0.1",
    "electron": "^29.4.0",
    "electron-builder": "24.13.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.17",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "wait-on": "7.2.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "build": {
    "appId": "si.gradnja.stroski",
    "productName": "Gradnja - stroški",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "prisma/schema.prisma",
      "prisma/template.db.base64",
      "resources/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone"
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      },
      {
        "from": "prisma/template.db.base64",
        "to": "app/prisma/template.db.base64"
      },
      {
        "from": "resources",
        "to": "app/resources"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
